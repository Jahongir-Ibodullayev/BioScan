# Lokal development (.env gitignore'da — commit qilinmaydi)
# PostgreSQL/Redis lokalda shart emas; SQLite + graceful-degrade ishlatamiz.
SECRET_KEY=dev-local-secret-key-stable-for-local-run-1234567890
DEBUG=true
ENV=development
APP_VERSION=bioscan-fastapi@1.0.0

# Lokal SQLite — fayl asosida (testlar bilan bir xil mexanizm)
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Redis ixtiyoriy — ulanmasa cache silently o'chadi
REDIS_URL=redis://127.0.0.1:6379/0

# CORS — lokal frontend portlari
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_LIFETIME_MIN=1440
JWT_REFRESH_LIFETIME_DAYS=30

# AI / Telegram / Firebase / Sentry — bo'sh (tegishli funksiyalar o'chiq)
OPENROUTER_API_KEY=
GROQ_API_KEY=
TELEGRAM_BOT_TOKEN=
FCM_CREDENTIALS_PATH=
SENTRY_DSN=
