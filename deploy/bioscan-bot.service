[Unit]
Description=BioScan Telegram bot (polling)
After=network.target

[Service]
User=kayumovvv
Group=kayumovvv
WorkingDirectory=/home/kayumovvv/loyihalarim/bioscan-fastapi
EnvironmentFile=/home/kayumovvv/loyihalarim/bioscan-fastapi/.env
ExecStart=/home/kayumovvv/loyihalarim/bioscan-fastapi/venv/bin/python -m app.bot.run
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
