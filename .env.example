SECRET_KEY=change-me-in-production-this-must-be-long-and-random
DEBUG=false
ENV=production
APP_VERSION=bioscan-fastapi@1.0.0

# Django bilan bir xil DB — migratsiya kerak emas
DATABASE_URL=postgresql+asyncpg://togai:togai@127.0.0.1:5432/togai
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# CORS
CORS_ORIGINS=https://bioscan.duckdns.org,https://bioscan-startup.vercel.app,http://localhost:5173

# JWT — Django SimpleJWT bilan teng bo'lsin uchun SECRET_KEY ham bir xil
JWT_ALGORITHM=HS256
JWT_ACCESS_LIFETIME_MIN=1440
JWT_REFRESH_LIFETIME_DAYS=30

# AI
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=meta-llama/llama-3.2-90b-vision-instruct
OPENROUTER_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct
GROQ_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=Bioscanuz_bot
TELEGRAM_OTP_BOT_TOKEN=
TELEGRAM_OTP_BOT_USERNAME=TogOTP_bot

# Firebase
FCM_CREDENTIALS_PATH=

# Sentry
SENTRY_DSN=
SENTRY_TRACES=0.1
