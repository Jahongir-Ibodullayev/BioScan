# Copy to .env and fill in
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite lokal development uchun default. PostgreSQL ishlatmoqchi bo'lsangiz:
# USE_POSTGRES=True
# USE_SQLITE=False
DB_NAME=togai
DB_USER=togai
DB_PASSWORD=togai_pass
DB_HOST=localhost
DB_PORT=5432

# CORS — frontend manzili
FRONTEND_URL=http://localhost:5173
