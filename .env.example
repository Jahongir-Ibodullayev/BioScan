# Copy to .env and fill in
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=togai
DB_USER=togai
DB_PASSWORD=togai_pass
DB_HOST=localhost
DB_PORT=5432

# Agar PostgreSQL hali yo'q bo'lsa — SQLite rejimiga o'tish uchun:
# USE_SQLITE=1

# CORS — frontend manzili
FRONTEND_URL=http://localhost:5173
