{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "phases": {
        "setup": { "nixPkgs": ["python312"] }
      }
    }
  },
  "deploy": {
    "startCommand": "python manage.py migrate --noinput && python -m gunicorn togai.wsgi --bind 0.0.0.0:$PORT --workers 2 --timeout 60 --log-file -",
    "healthcheckPath": "/api/species/",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
