{
  // Terminal > Run Task... menyusidan ishga tushiriladi
  "version": "2.0.0",
  "tasks": [
    {
      "label": "BioScan: Init SQLite tables",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [".vscode/init_db.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "BioScan: Run tests",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "pytest", "-q"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
